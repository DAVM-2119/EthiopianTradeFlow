# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-change-this-in-production-tradeflow-local-dev-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL + PostGIS)
# Uses postgis engine scheme for Django GeoDjango PostGIS backend
DATABASE_URL=postgis://postgres:root@localhost:5432/tradeflow_db
TEST_DATABASE_URL=postgis://postgres:root@localhost:5432/tradeflow_test_db

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
